# API PNCP (pública, sem chave)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_PAGE_SIZE=50
PNCP_REQUEST_TIMEOUT_S=60
PNCP_MAX_RETRIES=5
PNCP_USER_AGENT=pncp-pipeline-portfolio/0.1

# Armazenamento local
RAW_DATA_DIR=data/raw
SILVER_DATA_DIR=data/processed
GOLD_DATA_DIR=data/gold
DELTA_DATA_DIR=data/delta

# API IBGE (enriquecimento populacional opcional)
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v3

# Modo de implantação e exposição de rede (local | shared)
# Por padrão os serviços escutam apenas em 127.0.0.1.
# Em PNCP_DEPLOY_MODE=shared ou bind externo (ex.: 0.0.0.0), substitua TODOS os segredos por valores fortes.
PNCP_DEPLOY_MODE=local
POSTGRES_BIND_HOST=127.0.0.1
AIRFLOW_BIND_HOST=127.0.0.1

# PostgreSQL (uso local com Docker Compose; obrigatório no .env)
# No Docker Compose (e quando DATABASE_URL fica omitida localmente), POSTGRES_PASSWORD recebe URL-encoding automático.
POSTGRES_USER=pncp
POSTGRES_PASSWORD=dev-local-postgres-password
POSTGRES_DB=pncp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pncp:dev-local-postgres-password@localhost:5432/pncp

# Apache Airflow 3 (seguro por padrão: autenticação ativa e sem all-admins)
AIRFLOW_PORT=8080
AIRFLOW_SIMPLE_AUTH_ALL_ADMINS=False
AIRFLOW_JWT_SECRET=dev-local-jwt-secret-key-at-least-32-bytes
# Opcional em modo local; obrigatório em modo shared (32 bytes base64 urlsafe / Fernet)
AIRFLOW_FERNET_KEY=

# Observabilidade
LOG_LEVEL=INFO
LOG_FORMAT=json
