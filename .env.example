# API PNCP (pública, sem chave)
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_PAGE_SIZE=50
PNCP_REQUEST_TIMEOUT_S=60
PNCP_MAX_RETRIES=5
PNCP_USER_AGENT=pncp-pipeline-portfolio/0.1

# Armazenamento local
RAW_DATA_DIR=data/raw

# PostgreSQL (uso local com Docker Compose)
POSTGRES_USER=pncp
POSTGRES_PASSWORD=pncp
POSTGRES_DB=pncp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pncp:pncp@localhost:5432/pncp
